{
  "routes": [
    {
      "src": "^/_next/.*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "^/static/.*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "^/(api/.*)",
      "dest": "/$1"
    },
    {
      "src": "^/((?!_next|api|favicon.ico).*)",
      "dest": "/"
    }
  ]
}